app_name    = "your-app-name"
env_name    = "dev"                # e.g., dev or demo
aws_profile = "your-aws-profile"   # e.g., dev or demo
aws_region  = "us-east-1"

vpc_cidr = "10.0.0.0/16"

azs = [
  "us-east-1a",
  "us-east-1b",
  "us-east-1c"
]

public_subnet_cidrs = [
  "10.0.1.0/24",
  "10.0.2.0/24",
  "10.0.3.0/24"
]

private_subnet_cidrs = [
  "10.0.101.0/24",
  "10.0.102.0/24",
  "10.0.103.0/24"
]

tags = {
  Owner       = "your-name"
  Environment = "dev"
}
